#include <winver.h>

1 VERSIONINFO
FILEVERSION PLUGIN_VERSION_MAJOR,PLUGIN_VERSION_MINOR,PLUGIN_VERSION_PATCH,0
PRODUCTVERSION PLUGIN_VERSION_MAJOR,PLUGIN_VERSION_MINOR,PLUGIN_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", PLUGIN_DESCRIPTION
            VALUE "FileVersion", PLUGIN_VERSION_TEXT
            VALUE "InternalName", PLUGIN_NAME
            VALUE "LegalCopyright", PLUGIN_AUTHOR
            VALUE "ProductName", PLUGIN_NAME
            VALUE "ProductVersion", PLUGIN_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
